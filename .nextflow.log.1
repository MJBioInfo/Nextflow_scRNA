  """
  #!/usr/bin/env Rscript
  library(Seurat)
  library(tidyverse)
  
  # Load preprocessed Seurat object
  seurat_obj <- readRDS("${preprocessed_object}")
  
  # Find markers
  pb_markers <- FindAllMarkers(seurat_obj, only.pos = TRUE, test.use = "wilcox")
  
  # Save marker table
  saveRDS(pb_markers, "pb_markers.rds")
  
  # Filter top 10 genes per cluster with avg_log2FC > 1
  top10 <- pb_markers %>%
    group_by(seurat_clusters) %>%
    filter(avg_log2FC > 1) %>%
    slice_head(n = 10) %>%
    ungroup()
  
  # Generate heatmap
  heatmap_plot <- DoHeatmap(pb_markers, features = top10$gene) + NoLegend()
  ggsave("pb_top10_heatmap.png", plot = heatmap_plot)
  """

