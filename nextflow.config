/*
================================================================================

Here we add configuration files such as docker , manifest , profiles , process

================================================================================
*/


conda.enabled = true

docker.enabled = true
docker.runOptions = '-u $(id -u):$(id -g)'


manifest {
  description = 'Running Nextflow script for single cell seurat' 
  author = 'Majeed Jamakhani'
  nextflowVersion = '24.04.2'
}


profiles {
  standard {
    process.container = 'satijalab/seurat:5.0.0'
  }

  conda {
    process.conda = '/Users/majeedjamakhani/Softwares/miniconda3/envs/my_r_env'
  }

  
  docker {
    process.container = 'satijalab/seurat:5.0.0'
    docker.runOptions='-u $(id -u):$(id -g)'
    docker.enabled = true
  }

}






